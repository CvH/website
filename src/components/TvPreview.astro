---
import { getSortedPosts } from '../utils/posts';
import { getLatestVersion } from '../utils/downloads';
import LibreElecLogo from './LibreElecLogo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = base ? `${base}/` : '/';
const downloadsUrl = `${base}/downloads/`;

const latestVersion = getLatestVersion();
const allPosts = await getSortedPosts();
const latestRelease = allPosts.find((p) => p.category === 'release') || allPosts[0];
const latestHeadline = latestRelease?.post.data.title || `LibreELEC ${latestVersion.name}`;
const latestReleaseUrl = latestRelease?.url || `${homeUrl}#news`;

// Kodi and LibreELEC version string formatting
const kodiLabel = latestVersion.kodiVersion.startsWith('v')
    ? latestVersion.kodiVersion
    : `v${latestVersion.kodiVersion}`;
const releaseVersionLabel = latestVersion.downloadVersion || latestVersion.name;
---

<header class="relative pt-28 pb-14 md:pt-32 md:pb-16 border-b border-slate-200/80 dark:border-slate-800/80 bg-gradient-to-b from-slate-100/60 to-transparent dark:from-slate-900/40 dark:to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-8 md:mb-10">
            <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-4 leading-tight">
                Just enough OS for <span class="text-brand-600 dark:text-brand-400">Kodi</span>
            </h1>

            <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
                Turn your Raspberry Pi, PC, or Android box into a dedicated Kodi media center. Fast boot, zero bloat, purpose-built for the couch.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={downloadsUrl} class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm sm:text-base shadow-sm hover:shadow transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-download"></i> Download Images
                </a>
                <a href={`${homeUrl}#creator`} class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700/80 text-slate-800 dark:text-slate-100 font-semibold text-sm sm:text-base border border-slate-200 dark:border-slate-700 shadow-sm transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-compact-disc text-brand-600 dark:text-brand-400"></i> Create Boot Media
                </a>
            </div>
        </div>

        <!-- TV Bezel Screen Preview powered by Alpine.js -->
        <div class="relative max-w-4xl mx-auto" x-data="tvPreview">
            <!-- TV Outer Frame -->
            <div class="rounded-2xl p-2 sm:p-2.5 bg-slate-900 border border-slate-800 shadow-2xl">
                <!-- TV Display Screen -->
                <div class="relative rounded-xl overflow-hidden bg-slate-950 aspect-video">
                    <img
                        :src="activeItem.bg"
                        :alt="activeItem.title"
                        class="w-full h-full object-cover transition-opacity duration-200"
                        :style="`opacity: ${fading ? 0.3 : 1};`"
                        loading="eager"
                    />
                </div>

                <!-- TV Chin Branding Detail -->
                <div class="flex items-center justify-between px-3 pt-2 text-[11px] text-slate-400 font-mono select-none">
                    <span class="flex items-center gap-1.5">
                        <LibreElecLogo class="w-3.5 h-3.5 opacity-75" />
                        <span>LibreELEC {releaseVersionLabel}</span>
                    </span>
                    <span class="flex items-center gap-1.5 text-slate-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        <span>Kodi {kodiLabel}</span>
                    </span>
                </div>
            </div>

            <!-- TV Stand Base -->
            <div class="w-24 sm:w-32 h-2 bg-slate-800/90 border-t border-slate-700/60 mx-auto rounded-b-md shadow-sm"></div>

            <!-- View Switcher Tabs & Description below TV -->
            <div class="mt-6 flex flex-col items-center">
                <div class="inline-flex items-center p-1 rounded-xl bg-slate-200/80 dark:bg-slate-900/80 border border-slate-300/80 dark:border-slate-800 backdrop-blur-sm gap-1 max-w-full overflow-x-auto">
                    <button
                        type="button"
                        @click="switchPreview('video')"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-2 whitespace-nowrap"
                        :class="activeKey === 'video' ? 'bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                    >
                        <i class="fa-solid fa-film text-xs text-brand-500"></i>
                        <span>Movies & Video</span>
                    </button>
                    <button
                        type="button"
                        @click="switchPreview('pvr')"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-2 whitespace-nowrap"
                        :class="activeKey === 'pvr' ? 'bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                    >
                        <i class="fa-solid fa-tv text-xs text-brand-500"></i>
                        <span>Live TV & PVR</span>
                    </button>
                    <button
                        type="button"
                        @click="switchPreview('audio')"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-2 whitespace-nowrap"
                        :class="activeKey === 'audio' ? 'bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                    >
                        <i class="fa-solid fa-headphones text-xs text-brand-500"></i>
                        <span>Music & Audio</span>
                    </button>
                    <button
                        type="button"
                        @click="switchPreview('settings')"
                        class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-2 whitespace-nowrap"
                        :class="activeKey === 'settings' ? 'bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                    >
                        <i class="fa-solid fa-sliders text-xs text-brand-500"></i>
                        <span>Settings</span>
                    </button>
                </div>

                <div class="mt-4 text-center max-w-2xl px-4 min-h-[3.5rem]">
                    <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white" x-text="activeItem.title"></h3>
                    <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed" x-text="activeItem.desc"></p>
                </div>
            </div>
        </div>

    </div>
</header>
